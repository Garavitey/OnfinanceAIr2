# --- LLM ---
# Leave MOCK_LLM=1 to run the whole app with no API key (deterministic canned
# generation). Set MOCK_LLM=0 and supply a real key for live generation.
MOCK_LLM=1
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Storage ---
# Local default is SQLite; the docker-compose path uses the Postgres URL below.
DATABASE_URL=sqlite+aiosqlite:///./uml.db
# DATABASE_URL=postgresql+psycopg://uml:uml@localhost:5432/uml

# --- Cache (optional; unset means in-process fallback) ---
# REDIS_URL=redis://localhost:6379/0

# --- PlantUML rendering ---
# Local jar is the default. KROKI_URL is opt-in only: setting it sends diagram
# source to a third-party service.
PLANTUML_JAR=vendor/plantuml.jar
# KROKI_URL=http://localhost:8000
